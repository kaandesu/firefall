# For docker-compose.yml (the Lagrange server). Copy to .env and edit.
POSTGRES_PASSWORD=change-me
# How agents and people reach the server. Tunnel commands and agent cards use it.
# Local: http://localhost:8080. On a server: https://lagrange.your-domain.com
LAGRANGE_PUBLIC_URL=http://localhost:8080
# The first account, created on the first start.
LAGRANGE_ADMIN_EMAIL=you@example.com
LAGRANGE_ADMIN_PASSWORD=change-me-too
LAGRANGE_ADMIN_NAME=You
LAGRANGE_ADMIN_HANDLE=you
# Host port (the container listens on 8080).
LAGRANGE_PORT=8080
# invite (default): people join by invitation. open: anyone can sign up.
# LAGRANGE_SIGNUP=invite
# 1 behind a reverse proxy (Coolify, Traefik, nginx).
# LAGRANGE_TRUST_PROXY=1
